{
  "identifier": "default",
  "description": "Default capabilities for Career Coach",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "sql:default",
    "sql:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": true
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "core:webview:allow-print",
    "dialog:default"
  ]
}
